{
  "name": "dsh-cloud-servers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "云服务器工作台：在 DeepSeek Harness 里登记、巡检、执行命令并管理你的云服务器（SSH 密钥 / 密码），支持在对话里 @ 选机。",
  "license": "MIT",
  "author": "MrLukezy",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLukezy/dsh-cloud-servers.git"
  },
  "homepage": "https://github.com/MrLukezy/dsh-cloud-servers#readme",
  "bugs": {
    "url": "https://github.com/MrLukezy/dsh-cloud-servers/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "seed-servers.example.json",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ssh",
    "cloud",
    "server",
    "server-monitor",
    "devops",
    "云服务器",
    "运维"
  ]
}